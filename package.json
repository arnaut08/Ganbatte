{
  "name": "ganbatte",
  "version": "1.0.0",
  "description": "Kana Reading Assessment Web App",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev",
    "generate:genki-lessons": "cd server && node scripts/generate-genki-lessons.js",
    "generate:kanji": "cd server && node scripts/generate-kanji.js",
    "build": "cd client && npm run build",
    "start": "cd server && npm start"
  },
  "author": "Archit Nautiyal",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
