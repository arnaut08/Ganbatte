{
  "name": "ganbatte",
  "version": "1.0.0",
  "description": "Kana Reading Assessment Web App",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev",
    "generate:genki-lessons": "cd server && node scripts/generate-genki-lessons.js",
    "generate:kanji": "cd server && node scripts/generate-kanji.js",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json",
    "test": "node --import tsx --test client/src/utils/*.test.js server/middleware/auth.test.js server/services/*.test.js"
  },
  "author": "Archit Nautiyal",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3",
    "tsx": "^4.20.3"
  }
}
